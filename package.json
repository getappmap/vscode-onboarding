{
  "name": "onboarding",
  "displayName": "Onboarding",
  "description": "Set up a developer's computer for a repository: check, fix and prove each tool and credential it needs, with help from GitHub Copilot",
  "publisher": "appland",
  "version": "1.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/getappmap/vscode-onboarding.git"
  },
  "bugs": {
    "url": "https://github.com/getappmap/vscode-onboarding/issues"
  },
  "homepage": "https://github.com/getappmap/vscode-onboarding#readme",
  "engines": {
    "vscode": "^1.134.0",
    "node": ">=24"
  },
  "categories": [
    "Other",
    "AI",
    "Chat"
  ],
  "keywords": [
    "onboarding",
    "setup",
    "developer environment",
    "dev environment",
    "copilot",
    "agent skills",
    "manifest"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:onboarding.yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Setup commands run only in folders you trust."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "onboarding.runSetup",
        "title": "Run Setup",
        "category": "Onboarding",
        "icon": "$(play)"
      },
      {
        "command": "onboarding.stopSetup",
        "title": "Stop Setup",
        "category": "Onboarding",
        "icon": "$(debug-stop)",
        "enablement": "onboarding.running"
      },
      {
        "command": "onboarding.runEntry",
        "title": "Run This Step",
        "category": "Onboarding",
        "icon": "$(play)"
      },
      {
        "command": "onboarding.reproveSetup",
        "title": "Run Setup, Proving Everything Again",
        "category": "Onboarding"
      },
      {
        "command": "onboarding.askCopilot",
        "title": "Ask Copilot to Help",
        "category": "Onboarding",
        "icon": "$(copilot)"
      },
      {
        "command": "onboarding.askCopilotAboutEntry",
        "title": "Ask Copilot to Help",
        "category": "Onboarding",
        "icon": "$(copilot)"
      },
      {
        "command": "onboarding.draftManifest",
        "title": "Draft Manifest",
        "category": "Onboarding"
      },
      {
        "command": "onboarding.showLog",
        "title": "Show Log",
        "category": "Onboarding"
      },
      {
        "command": "onboarding.showOutput",
        "title": "Show Setup Output",
        "category": "Onboarding",
        "icon": "$(output)"
      },
      {
        "command": "onboarding.showStatus",
        "title": "Show Setup Status",
        "category": "Onboarding",
        "icon": "$(open-preview)"
      },
      {
        "command": "onboarding.showEntry",
        "title": "Show Details",
        "category": "Onboarding"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onboarding",
          "title": "Onboarding",
          "icon": "media/onboarding.svg"
        }
      ]
    },
    "views": {
      "onboarding": [
        {
          "id": "onboarding.report",
          "name": "Onboarding"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "onboarding.report",
        "when": "onboarding.viewState == loading || !onboarding.viewState",
        "contents": "Reading onboarding.yaml…"
      },
      {
        "view": "onboarding.report",
        "when": "onboarding.viewState == no-folder",
        "contents": "Open a folder to set it up."
      },
      {
        "view": "onboarding.report",
        "when": "onboarding.viewState == invalid",
        "contents": "onboarding.yaml has problems, so there is nothing to show.\n[Show Problems](command:onboarding.showLog)"
      },
      {
        "view": "onboarding.report",
        "when": "onboarding.viewState == empty",
        "contents": "Onboarding sets up a developer's computer for this repository. It checks each tool and credential the project needs, installs what is missing, and proves it works.\nThis folder has nothing to set up yet: there is no onboarding.yaml, or it lists no setup steps. That file lists what to set up. Copilot can read the repository and draft it for you to review.\n[Draft Manifest](command:onboarding.draftManifest)\n[Learn more about Onboarding](command:extension.open?%5B%22appland.onboarding%22%5D)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "onboarding.runSetup",
          "when": "view == onboarding.report && !onboarding.running",
          "group": "navigation"
        },
        {
          "command": "onboarding.stopSetup",
          "when": "view == onboarding.report && onboarding.running",
          "group": "navigation"
        },
        {
          "command": "onboarding.askCopilot",
          "when": "view == onboarding.report",
          "group": "navigation"
        },
        {
          "command": "onboarding.showStatus",
          "when": "view == onboarding.report",
          "group": "navigation"
        },
        {
          "command": "onboarding.reproveSetup",
          "when": "view == onboarding.report",
          "group": "more@1"
        },
        {
          "command": "onboarding.showOutput",
          "when": "view == onboarding.report",
          "group": "more@2"
        }
      ],
      "view/item/context": [
        {
          "command": "onboarding.runEntry",
          "when": "view == onboarding.report && !onboarding.running",
          "group": "inline@1"
        },
        {
          "command": "onboarding.stopSetup",
          "when": "view == onboarding.report && viewItem =~ /^(checking|fixing|proving)$/",
          "group": "inline@1"
        },
        {
          "command": "onboarding.askCopilotAboutEntry",
          "when": "view == onboarding.report && viewItem =~ /^(failed|skipped)$/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "onboarding.stopSetup",
          "when": "onboarding.running"
        },
        {
          "command": "onboarding.askCopilotAboutEntry",
          "when": "false"
        },
        {
          "command": "onboarding.showEntry",
          "when": "false"
        },
        {
          "command": "onboarding.runEntry",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Onboarding",
      "properties": {
        "onboarding.orgSettingsUrl": {
          "type": "string",
          "default": "",
          "description": "Company settings server for the Org and Team layers. Must use https, except on this computer. Leave empty to use each project's onboarding.yaml alone."
        },
        "onboarding.secretCommand": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Command that prints one secret, signed in as you. {path} marks where the secret's path goes, for example `vault kv get -field=value {path}` or `op read {path}`."
        },
        "onboarding.askBeforeFixing": {
          "type": "boolean",
          "default": false,
          "description": "Ask before running each fix, showing the exact command. When off, fixes run without asking."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "onboarding.servers",
        "label": "Onboarding"
      }
    ],
    "languageModelTools": [
      {
        "name": "onboarding_check_entries",
        "toolReferenceName": "checkSetup",
        "displayName": "Check Onboarding Setup",
        "modelDescription": "Runs the check command of one entry, or every entry, in onboarding.yaml and returns which are ready with the last lines of output. Never changes anything and never runs fixes.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "entryId": {
              "type": "string",
              "description": "One entry id. Leave out to check every entry."
            }
          }
        }
      },
      {
        "name": "onboarding_section_sha",
        "toolReferenceName": "sectionSha",
        "displayName": "README Section SHA",
        "modelDescription": "Returns the SHA of one section of a Markdown file in the project, computed exactly as the onboarding extension's README check computes it. Use it for every sha256 in a from: field of onboarding.yaml; never compute a SHA yourself. Give the file relative to the project folder and the heading exactly as written, with its # marks. Reads only; changes nothing.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "required": [
            "file",
            "heading"
          ],
          "properties": {
            "file": {
              "type": "string",
              "description": "Path relative to the project folder, such as README.md."
            },
            "heading": {
              "type": "string",
              "description": "The heading line exactly as written, such as ## Run locally."
            }
          }
        }
      }
    ],
    "chatSkills": [
      {
        "path": "./dist/skills/vscode/onboarding-manifest-writer/SKILL.md"
      },
      {
        "path": "./dist/skills/vscode/onboarding-text-reader/SKILL.md"
      },
      {
        "path": "./dist/skills/vscode/onboarding-setup/SKILL.md"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run lint && node esbuild.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "mocha",
    "pretest:vscode": "npm run compile-tests && npm run compile",
    "test:vscode": "vscode-test",
    "vsix": "vsce package --no-dependencies",
    "skills:zip": "rm -f onboarding-skills.zip && cd dist/skills/standalone && zip -rqX ../../../onboarding-skills.zip . -x '.*' '*/.*'"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "~1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "mocha": "^12.0.3",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true
  }
}
