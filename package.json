{
  "name": "onboarding",
  "displayName": "Onboarding",
  "description": "Sets up a developer's computer for this repository",
  "publisher": "your-company",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0",
    "node": ">=24"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:onboarding.yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Setup commands run only in folders you trust."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "onboarding.runSetup",
        "title": "Run Setup",
        "category": "Onboarding",
        "icon": "$(play)"
      },
      {
        "command": "onboarding.reproveSetup",
        "title": "Run Setup, Proving Everything Again",
        "category": "Onboarding"
      },
      {
        "command": "onboarding.askCopilot",
        "title": "Ask Copilot to Help",
        "category": "Onboarding",
        "icon": "$(copilot)"
      },
      {
        "command": "onboarding.askCopilotAboutEntry",
        "title": "Ask Copilot to Help",
        "category": "Onboarding",
        "icon": "$(copilot)"
      },
      {
        "command": "onboarding.draftManifest",
        "title": "Draft Manifest",
        "category": "Onboarding"
      },
      {
        "command": "onboarding.showLog",
        "title": "Show Log",
        "category": "Onboarding"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onboarding",
          "title": "Onboarding",
          "icon": "media/onboarding.svg"
        }
      ]
    },
    "views": {
      "onboarding": [
        {
          "id": "onboarding.report",
          "name": "Onboarding"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "onboarding.report",
        "when": "onboarding.viewState == loading || !onboarding.viewState",
        "contents": "Reading onboarding.yaml…"
      },
      {
        "view": "onboarding.report",
        "when": "onboarding.viewState == no-folder",
        "contents": "Open a folder to set it up."
      },
      {
        "view": "onboarding.report",
        "when": "onboarding.viewState == invalid",
        "contents": "onboarding.yaml has problems, so there is nothing to show.\n[Show Problems](command:onboarding.showLog)"
      },
      {
        "view": "onboarding.report",
        "when": "onboarding.viewState == empty",
        "contents": "This folder has nothing to set up yet: there is no onboarding.yaml, or it has no entries.\n[Draft Manifest](command:onboarding.draftManifest)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "onboarding.runSetup",
          "when": "view == onboarding.report",
          "group": "navigation"
        },
        {
          "command": "onboarding.askCopilot",
          "when": "view == onboarding.report",
          "group": "navigation"
        },
        {
          "command": "onboarding.reproveSetup",
          "when": "view == onboarding.report",
          "group": "more@1"
        }
      ],
      "view/item/context": [
        {
          "command": "onboarding.askCopilotAboutEntry",
          "when": "view == onboarding.report && viewItem =~ /^(failed|skipped|needs-approval)$/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "onboarding.askCopilotAboutEntry",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Onboarding",
      "properties": {
        "onboarding.orgSettingsUrl": {
          "type": "string",
          "default": "",
          "description": "Company settings server for the Org and Team layers and the fixes approved in advance. Must use https, except on this computer. Leave empty to use each project's onboarding.yaml alone."
        },
        "onboarding.secretCommand": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Command that prints one secret, signed in as you. {path} marks where the secret's path goes, for example `vault kv get -field=value {path}` or `op read {path}`."
        },
        "onboarding.askBeforeFixing": {
          "type": "boolean",
          "default": false,
          "description": "Ask before running each fix, showing the exact command. When off, fixes run without asking, except those that need another team's approval."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "onboarding.servers",
        "label": "Onboarding"
      }
    ],
    "languageModelTools": [
      {
        "name": "onboarding_check_entries",
        "toolReferenceName": "checkSetup",
        "displayName": "Check Onboarding Setup",
        "modelDescription": "Runs the check command of one entry, or every entry, in onboarding.yaml and returns which are ready with the last lines of output. Never changes anything and never runs fixes.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "entryId": {
              "type": "string",
              "description": "One entry id. Leave out to check every entry."
            }
          }
        }
      },
      {
        "name": "onboarding_section_sha",
        "toolReferenceName": "sectionSha",
        "displayName": "README Section SHA",
        "modelDescription": "Returns the SHA of one section of a Markdown file in the project, computed exactly as the onboarding extension's README check computes it. Use it for every sha256 in a from: field of onboarding.yaml; never compute a SHA yourself. Give the file relative to the project folder and the heading exactly as written, with its # marks. Reads only; changes nothing.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "required": [
            "file",
            "heading"
          ],
          "properties": {
            "file": {
              "type": "string",
              "description": "Path relative to the project folder, such as README.md."
            },
            "heading": {
              "type": "string",
              "description": "The heading line exactly as written, such as ## Run locally."
            }
          }
        }
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/manifest-writer/SKILL.md"
      },
      {
        "path": "./skills/text-reader/SKILL.md"
      },
      {
        "path": "./skills/troubleshooter/SKILL.md"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "mocha",
    "pretest:vscode": "npm run compile-tests && npm run compile",
    "test:vscode": "vscode-test",
    "vsix": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "~1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "mocha": "^12.0.3",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true
  }
}
